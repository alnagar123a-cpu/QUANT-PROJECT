//@version=5

// =============================================================================
// Momentum ROC Signal [ES/NQ 5m]
//
// A momentum-based signal indicator built for ES/NQ index futures on the
// 5-minute chart. Rate-of-change (ROC) momentum is smoothed with a moving
// average, filtered by trend direction and volatility, and optionally
// restricted to regular trading hours to reduce whipsaws in low-liquidity
// overnight Globex sessions. Default lengths are tuned for the faster,
// noisier bar-to-bar behavior of a 5-minute chart versus a 1-hour chart
// (shorter ROC/smoothing to stay responsive, a longer trend EMA so "trend"
// still reflects the broader session rather than a few minutes of chop).
//
// NOTE ON PANE LAYOUT: the script itself is declared overlay=false so the
// momentum oscillator gets its own separate pane below the price chart.
// The long/short arrows, stop-loss/take-profit levels, background regime
// shading and the optional trend EMA are pushed onto the main price chart
// individually via the force_overlay=true argument on each plotting call.
//
// NOTE ON REPAINTING: every calculation below (ROC, smoothing, ATR, trend
// EMA) is derived purely from close/high/low/volume of the current and
// prior bars -- no request.security() with lookahead, and no reference to
// unconfirmed future data. Signal conditions are additionally gated with
// barstate.isconfirmed so a long/short marker is only drawn once its bar
// has actually closed, meaning a plotted signal never disappears or moves
// after the fact.
// =============================================================================
indicator("Momentum ROC Signal [ES/NQ 5m]", shorttitle = "Mom ROC Signal", overlay = false, format = format.price)

// -----------------------------------------------------------------------------
// INPUTS
// -----------------------------------------------------------------------------
grpMom    = "Momentum (ROC)"
grpTrend  = "Trend Filter"
grpVol    = "Volatility Filter"
grpSess   = "Session Filter"
grpRisk   = "Risk Levels"
grpDisp   = "Display"

rocLen        = input.int(10, "ROC Lookback Period", minval = 1, group = grpMom, tooltip = "Number of bars used to measure percentage price change (rate of change). 10 bars = 50 minutes on a 5m chart.")
smoothType    = input.string("EMA", "Smoothing Type", options = ["SMA", "EMA"], group = grpMom)
smoothLen     = input.int(5, "Smoothing Length", minval = 1, group = grpMom)
momThreshold  = input.float(0.0, "Momentum Threshold (%)", minval = 0.0, step = 0.05, group = grpMom, tooltip = "Smoothed ROC must cross above +threshold (long) or below -threshold (short). Leave at 0 for a simple zero-line cross.")

trendFilterOn = input.bool(true, "Enable Trend Filter", group = grpTrend)
trendLen      = input.int(200, "Trend EMA Length", minval = 1, group = grpTrend, tooltip = "200 bars = ~16.7 hours on a 5m chart, i.e. roughly the prior full session -- keeps the trend read from being dominated by a few minutes of noise.")
showTrendEMA  = input.bool(true, "Plot Trend EMA on Chart", group = grpTrend)

volFilterOn   = input.bool(true, "Enable Volatility Filter", group = grpVol)
atrLen        = input.int(14, "ATR Length", minval = 1, group = grpVol)
atrBaseLen    = input.int(100, "ATR Baseline (Average) Length", minval = 1, group = grpVol, tooltip = "ATR is compared against its own moving average over this length to detect abnormally quiet conditions. 100 bars = ~8.3 hours on a 5m chart.")
volMult       = input.float(0.80, "Volatility Threshold Multiplier", minval = 0.0, step = 0.05, group = grpVol, tooltip = "Signals are suppressed when current ATR falls below (multiplier x average ATR), i.e. abnormally low volatility / chop.")

sessionFilterOn = input.bool(false, "Restrict Signals to Regular Trading Hours", group = grpSess)
sessionWindow   = input.session("0930-1600", "RTH Session", group = grpSess)
sessionTZ       = input.string("America/New_York", "Session Timezone", group = grpSess)

showRiskLevels = input.bool(true, "Show Entry / Stop Loss / Take Profit Levels", group = grpRisk)
stopAtrMult    = input.float(1.5, "Stop Loss (ATR Multiple)", minval = 0.1, step = 0.1, group = grpRisk, tooltip = "Stop loss is placed this many ATRs away from the entry price, on the opposite side of the trade.")
rewardMult     = input.float(2.0, "Take Profit (Risk:Reward Multiple)", minval = 0.1, step = 0.1, group = grpRisk, tooltip = "Take-profit target is placed at (risk distance x this multiple) beyond the entry price, i.e. where to exit/sell the position.")

showArrows    = input.bool(true, "Show Long/Short Arrows on Chart", group = grpDisp)
showBgShade   = input.bool(true, "Show Background Regime Shading", group = grpDisp)
histStyle     = input.string("Histogram", "Oscillator Plot Style", options = ["Histogram", "Line"], group = grpDisp)

// -----------------------------------------------------------------------------
// MOMENTUM CALCULATION -- Rate of Change smoothed by SMA/EMA
// -----------------------------------------------------------------------------
// ta.roc() returns 100 * (close - close[rocLen]) / close[rocLen], i.e. the
// percentage price change over the lookback period. This is the primary
// signal driver.
rawRoc = ta.roc(close, rocLen)

// Smooth the raw ROC to filter out single-bar noise/false signals.
smoothedMom = smoothType == "EMA" ? ta.ema(rawRoc, smoothLen) : ta.sma(rawRoc, smoothLen)

// Slope of the smoothed momentum line, used to require the crossover to be
// accompanied by expanding (not just barely tagging) momentum.
momRising  = smoothedMom > smoothedMom[1]
momFalling = smoothedMom < smoothedMom[1]

// -----------------------------------------------------------------------------
// TREND FILTER -- price relative to a longer-term EMA
// -----------------------------------------------------------------------------
// Only allow long signals when price sits above the higher-timeframe trend
// EMA, and short signals when price sits below it. This keeps momentum
// signals aligned with the dominant trend and cuts down on whipsaws during
// range-bound ES/NQ sessions.
trendEMA  = ta.ema(close, trendLen)
uptrend   = close > trendEMA
downtrend = close < trendEMA

trendOKLong  = not trendFilterOn or uptrend
trendOKShort = not trendFilterOn or downtrend

// -----------------------------------------------------------------------------
// VOLATILITY FILTER -- ATR vs. its own baseline average
// -----------------------------------------------------------------------------
// Compares current ATR to a longer moving average of ATR. When current ATR
// drops below (volMult x baseline ATR), the market is treated as abnormally
// quiet/choppy (common during overnight/low-liquidity hours on index
// futures) and signals are suppressed.
atrVal      = ta.atr(atrLen)
atrBaseline = ta.sma(atrVal, atrBaseLen)
volOK       = not volFilterOn or atrVal >= volMult * atrBaseline

// -----------------------------------------------------------------------------
// SESSION FILTER -- optional restriction to regular trading hours
// -----------------------------------------------------------------------------
// time() returns a non-na timestamp only for bars whose bar-open falls
// inside the specified session window/timezone, and na otherwise, giving a
// clean boolean test with no repaint risk.
inSessionWindow = not na(time(timeframe.period, sessionWindow, sessionTZ))
sessionOK       = not sessionFilterOn or inSessionWindow

// -----------------------------------------------------------------------------
// SIGNAL LOGIC -- zero/threshold crossover + slope + trend + volatility + session
// -----------------------------------------------------------------------------
crossUpRaw   = ta.crossover(smoothedMom, momThreshold)
crossDownRaw = ta.crossunder(smoothedMom, -momThreshold)

longCondition  = crossUpRaw   and momRising  and trendOKLong  and volOK and sessionOK
shortCondition = crossDownRaw and momFalling and trendOKShort and volOK and sessionOK

// Gate with barstate.isconfirmed so a marker only prints once its bar has
// actually closed -- this is what makes the signals non-repainting: a
// signal that appears will never later vanish or shift to a different bar.
longSignal  = longCondition  and barstate.isconfirmed
shortSignal = shortCondition and barstate.isconfirmed

// -----------------------------------------------------------------------------
// RISK LEVELS -- ATR-based stop loss and take-profit (exit) for each signal
// -----------------------------------------------------------------------------
// Stop loss is placed stopAtrMult ATRs beyond the entry, on the side that
// invalidates the trade. Take profit (the price to sell/cover at) is placed
// at rewardMult times that risk distance beyond the entry. Levels are fixed
// at the moment a signal fires (using that bar's already-confirmed ATR) and
// held until price trades through either level or a new signal replaces the
// trade -- this is a visualization of a single hypothetical trade, not an
// execution engine.
var float entryPrice      = na
var float stopLossPrice   = na
var float takeProfitPrice = na
var int   posDir          = 0   // 1 = long open, -1 = short open, 0 = flat

// On-chart drawings belonging to the currently displayed trade. They are
// kept as var references so they can be explicitly deleted: once a trade is
// invalidated (stop or target hit) or replaced by a new signal, its arrow
// and SL/TP labels are removed instead of being left on the chart.
var label arrowLbl = na
var label slLbl    = na
var label tpLbl    = na

// A fresh signal always replaces whatever trade/drawings are on screen.
// label.delete() is a safe no-op when the id is na, so this also covers the
// very first signal on the chart, where nothing has been drawn yet.
if longSignal or shortSignal
    label.delete(arrowLbl)
    label.delete(slLbl)
    label.delete(tpLbl)
    arrowLbl := na
    slLbl    := na
    tpLbl    := na

if longSignal
    entryPrice      := close
    stopLossPrice   := close - atrVal * stopAtrMult
    takeProfitPrice := close + (close - stopLossPrice) * rewardMult
    posDir          := 1
    if showArrows
        arrowLbl := label.new(bar_index, na, text = "LONG @ " + str.tostring(entryPrice, format.mintick), style = label.style_triangleup, yloc = yloc.belowbar, color = color.new(color.lime, 0), textcolor = color.black, size = size.small, force_overlay = true)
    if showRiskLevels
        slLbl := label.new(bar_index, stopLossPrice,   text = "SL " + str.tostring(stopLossPrice, format.mintick),   style = label.style_label_left, color = color.new(color.red, 20),   textcolor = color.white, size = size.tiny, force_overlay = true)
        tpLbl := label.new(bar_index, takeProfitPrice, text = "TP " + str.tostring(takeProfitPrice, format.mintick), style = label.style_label_left, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny, force_overlay = true)

if shortSignal
    entryPrice      := close
    stopLossPrice   := close + atrVal * stopAtrMult
    takeProfitPrice := close - (stopLossPrice - close) * rewardMult
    posDir          := -1
    if showArrows
        arrowLbl := label.new(bar_index, na, text = "SHORT @ " + str.tostring(entryPrice, format.mintick), style = label.style_triangledown, yloc = yloc.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.small, force_overlay = true)
    if showRiskLevels
        slLbl := label.new(bar_index, stopLossPrice,   text = "SL " + str.tostring(stopLossPrice, format.mintick),   style = label.style_label_left, color = color.new(color.red, 20),   textcolor = color.white, size = size.tiny, force_overlay = true)
        tpLbl := label.new(bar_index, takeProfitPrice, text = "TP " + str.tostring(takeProfitPrice, format.mintick), style = label.style_label_left, color = color.new(color.green, 20), textcolor = color.white, size = size.tiny, force_overlay = true)

// Once confirmed price action trades through the stop or the target, the
// trade is invalid: clear its tracked state and remove its arrow/SL/TP
// labels from the chart -- this is the "invalidated trade" cleanup.
if posDir == 1 and (low <= stopLossPrice or high >= takeProfitPrice)
    posDir := 0
    label.delete(arrowLbl)
    label.delete(slLbl)
    label.delete(tpLbl)
    arrowLbl := na
    slLbl    := na
    tpLbl    := na
if posDir == -1 and (high >= stopLossPrice or low <= takeProfitPrice)
    posDir := 0
    label.delete(arrowLbl)
    label.delete(slLbl)
    label.delete(tpLbl)
    arrowLbl := na
    slLbl    := na
    tpLbl    := na

// -----------------------------------------------------------------------------
// PLOTS -- oscillator pane
// -----------------------------------------------------------------------------
// Color-code the oscillator by sign (bullish/bearish) and by slope
// (strengthening vs. fading) for a quick visual read of momentum quality.
momColor = smoothedMom >= 0
     ? (momRising  ? color.new(color.lime,  0)  : color.new(color.green, 45))
     : (momFalling ? color.new(color.red,   0)  : color.new(color.orange, 45))

plot(histStyle == "Histogram" ? smoothedMom : na, title = "Momentum (Histogram)", style = plot.style_columns, color = momColor)
plot(histStyle == "Line" ? smoothedMom : na, title = "Momentum (Line)", style = plot.style_line, color = momColor, linewidth = 2)

hline(0, "Zero Line", color = color.gray, linestyle = hline.style_solid)
plot(momThreshold  != 0 ? momThreshold  : na, title = "Long Threshold",  color = color.new(color.green, 60), style = plot.style_line)
plot(momThreshold  != 0 ? -momThreshold : na, title = "Short Threshold", color = color.new(color.red,   60), style = plot.style_line)

// Small markers in the oscillator pane at the exact bar of each confirmed signal.
plotshape(longSignal,  title = "Long (oscillator pane)",  style = shape.triangleup,   location = location.bottom, color = color.lime, size = size.tiny)
plotshape(shortSignal, title = "Short (oscillator pane)", style = shape.triangledown, location = location.top,    color = color.red,  size = size.tiny)

// -----------------------------------------------------------------------------
// PLOTS -- pushed onto the main price chart via force_overlay
// -----------------------------------------------------------------------------
plot(showTrendEMA ? trendEMA : na, title = "Trend EMA", color = color.new(color.blue, 20), linewidth = 2, force_overlay = true)

// The long/short arrow and its entry price, plus the SL/TP labels, are
// drawn up in the RISK LEVELS block above (where they're created as
// deletable label objects) so they can be removed the instant a trade is
// invalidated. Only the continuous step-lines for the SL/TP levels live
// here, since plot() series naturally stop drawing once posDir returns to
// flat -- they break (via style_linebr) whenever there is no open trade or
// a new one starts, so each trade gets its own clearly bounded pair of
// levels.
plot(showRiskLevels and posDir != 0 ? stopLossPrice   : na, title = "Stop Loss",   color = color.new(color.red,   0), style = plot.style_linebr, linewidth = 1, force_overlay = true)
plot(showRiskLevels and posDir != 0 ? takeProfitPrice : na, title = "Take Profit", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1, force_overlay = true)

// Confirmed momentum regime = trend direction agrees with momentum sign
// (only meaningful to show once trend filter direction is established).
bullRegime = uptrend   and smoothedMom > momThreshold
bearRegime = downtrend and smoothedMom < -momThreshold
regimeColor = showBgShade ? (bullRegime ? color.new(color.green, 90) : bearRegime ? color.new(color.red, 90) : na) : na
bgcolor(regimeColor, title = "Momentum Regime Shading", force_overlay = true)

// -----------------------------------------------------------------------------
// ALERTS
// -----------------------------------------------------------------------------
// alertcondition() entries let TradingView's "Create Alert" dialog target
// this indicator directly. alert() calls below additionally fire a dynamic
// message that includes the actual entry, stop loss and take-profit prices
// for that signal, once per confirmed bar close (no repaint).
alertcondition(longSignal,  title = "Momentum Long Signal",  message = "Momentum ROC Long signal on {{ticker}} {{interval}} at {{close}}")
alertcondition(shortSignal, title = "Momentum Short Signal", message = "Momentum ROC Short signal on {{ticker}} {{interval}} at {{close}}")

if longSignal
    alert("Momentum ROC LONG " + syminfo.ticker + " " + timeframe.period + " | Entry " + str.tostring(entryPrice, format.mintick) + " | Stop " + str.tostring(stopLossPrice, format.mintick) + " | Target(sell) " + str.tostring(takeProfitPrice, format.mintick), alert.freq_once_per_bar_close)

if shortSignal
    alert("Momentum ROC SHORT " + syminfo.ticker + " " + timeframe.period + " | Entry " + str.tostring(entryPrice, format.mintick) + " | Stop " + str.tostring(stopLossPrice, format.mintick) + " | Target(cover) " + str.tostring(takeProfitPrice, format.mintick), alert.freq_once_per_bar_close)
